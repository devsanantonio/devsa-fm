# Copy to config.env and fill in. config.env is private: never commit or share it.

# YouTube Studio > Create > Go live > Stream > "Stream key". Anyone with it can broadcast as the channel.
YT_STREAM_KEY=

# How long each daily session runs, in seconds (9000 = 2.5 hours).
DURATION=9000

# Where the music lives. Each track's credit goes in credits.txt in the same folder.
# The music folder is chosen per scene by stream.sh. To use another for one run: MUSIC_DIR=… ./stream.sh
